<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 는 SplashScreen API가 windowBackground 대신 아래 배경색과 아이콘을 쓴다. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
